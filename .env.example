# =============================================================================
# MyNextJob — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values for local development.
# Never commit `.env.local` or real secrets to the repo.

# -----------------------------------------------------------------------------
# App origin (used in auth email redirects)
# -----------------------------------------------------------------------------
# Development: http://localhost:3000
# Production:  https://<your-domain>
# Do not ship localhost as a production value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Your project URL, e.g. https://xyzabc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your project's publishable (anon) key. This is the browser-safe key that
# is protected by Row Level Security policies. Do NOT put a service_role
# key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — Server-only (NEVER expose to browser code)
# -----------------------------------------------------------------------------
# The service_role key bypasses RLS and must only be used from trusted
# server code (Server Components, Route Handlers, Edge/Node functions).
# This variable is intentionally NOT prefixed with NEXT_PUBLIC_.
# Uncomment and set this when server-side privileged operations land in
# a later phase (e.g. job ingestion workers).
# SUPABASE_SERVICE_ROLE_KEY=
