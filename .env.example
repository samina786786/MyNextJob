# =============================================================================
# MyNextJob — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values for local development.
# Never commit `.env.local` or real secrets to the repo.

# -----------------------------------------------------------------------------
# App origin (used in auth email redirects)
# -----------------------------------------------------------------------------
# Development: http://localhost:3000
# Production:  https://<your-domain>
# Do not ship localhost as a production value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Your project URL, e.g. https://xyzabc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your project's publishable (anon) key. This is the browser-safe key that
# is protected by Row Level Security policies. Do NOT put a service_role
# key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — Server-only (NEVER expose to browser code)
# -----------------------------------------------------------------------------
# Server-only. Never expose with NEXT_PUBLIC_.
# Prefer the new secret API key (sb_secret_…). Unit tests use an in-memory
# store and do not require either key. Live Greenhouse ingestion requires
# this (or the legacy fallback below). Never send it to Greenhouse.
SUPABASE_SECRET_KEY=
# Optional legacy alias (JWT service_role). Used only if SUPABASE_SECRET_KEY
# is unset. Also server-only. Never expose with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Playwright authenticated feed tests (optional)
# -----------------------------------------------------------------------------
# Used only by `pnpm test:e2e` for /home infinite scroll. Never NEXT_PUBLIC_*.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
