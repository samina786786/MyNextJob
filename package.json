{
  "name": "mynextjob",
  "version": "0.1.0",
  "private": true,
  "description": "MyNextJob — Your next opportunity starts here.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/with-system-ca.mjs next dev",
    "build": "node scripts/with-system-ca.mjs next build",
    "start": "node scripts/with-system-ca.mjs next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-system-ca.mjs playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "jobs:synthetic": "vitest run tests/unit/jobs",
    "jobs:greenhouse": "node scripts/with-system-ca.mjs node scripts/jobs-greenhouse.mjs",
    "jobs:lever": "node scripts/with-system-ca.mjs node scripts/jobs-lever.mjs",
    "jobs:ashby": "node scripts/with-system-ca.mjs node scripts/jobs-ashby.mjs",
    "jobs:wwr": "node scripts/with-system-ca.mjs node scripts/jobs-wwr.mjs",
    "jobs:cleanup": "node scripts/with-system-ca.mjs node scripts/jobs-cleanup.mjs",
    "jobs:sync": "node scripts/with-system-ca.mjs node scripts/jobs-sync.mjs",
    "jobs:sources:verify": "node scripts/with-system-ca.mjs node scripts/jobs-sources-verify.mjs",
    "jobs:sources:audit": "node scripts/with-system-ca.mjs node scripts/jobs-sources-audit.mjs",
    "companies:assets": "node scripts/with-system-ca.mjs node scripts/companies-assets.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.2",
    "motion": "^11.11.11",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.4",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
